# ============================================================================
# Axxiom Platform - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
ENVIRONMENT=dev
LOG_LEVEL=debug
PORT=3000

# ============================================================================
# AZURE CONFIGURATION
# ============================================================================

# Azure Subscription
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=rg-axxiom-dev-eastus2
AZURE_REGION=eastus2

# Azure Service Principal (for CI/CD and automation)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CERTIFICATE_PATH=

# ============================================================================
# AZURE SERVICES
# ============================================================================

# Azure Key Vault
AZURE_KEY_VAULT_NAME=kv-axxiom-dev
AZURE_KEY_VAULT_URI=https://kv-axxiom-dev.vault.azure.net/

# Azure Storage (Data Lake)
AZURE_STORAGE_ACCOUNT_NAME=stadlsaxxiomdev
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_DATA_LAKE_CONTAINER=bronze

# Azure SQL Database
AZURE_SQL_SERVER=sql-axxiom-dev.database.windows.net
AZURE_SQL_DATABASE=db-axxiom-main
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_CONNECTION_STRING=

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://cosmos-axxiom-dev.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=axxiom-graph

# Azure Cache for Redis
AZURE_REDIS_HOST=redis-axxiom-dev.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=
AZURE_REDIS_CONNECTION_STRING=

# Azure Event Hubs
AZURE_EVENTHUB_NAMESPACE=evhns-axxiom-dev
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_NAME=events-main

# Azure Service Bus
AZURE_SERVICEBUS_NAMESPACE=sb-axxiom-dev
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_VALUATIONS=queue-valuations
AZURE_SERVICEBUS_QUEUE_ASSESSMENTS=queue-assessments
AZURE_SERVICEBUS_QUEUE_APPEALS=queue-appeals

# Azure AI Search
AZURE_SEARCH_SERVICE_NAME=search-axxiom-dev
AZURE_SEARCH_ENDPOINT=https://search-axxiom-dev.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_PROPERTIES=idx-properties
AZURE_SEARCH_INDEX_DOCUMENTS=idx-documents

# Azure OpenAI Service
AZURE_OPENAI_ENDPOINT=https://openai-axxiom-dev.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4_TURBO=gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-ada-002
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.7

# Azure Machine Learning
AZURE_ML_WORKSPACE_NAME=mlw-axxiom-dev
AZURE_ML_RESOURCE_GROUP=rg-axxiom-dev-ml
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_ENDPOINT_VALUATION=ep-valuation-prod

# Azure Application Insights
AZURE_APPINSIGHTS_CONNECTION_STRING=
AZURE_APPINSIGHTS_INSTRUMENTATION_KEY=

# Azure Container Registry
AZURE_CONTAINER_REGISTRY=craxxiomdev.azurecr.io
AZURE_CONTAINER_REGISTRY_USERNAME=
AZURE_CONTAINER_REGISTRY_PASSWORD=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL (Alternative to Azure SQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=axxiom_dev
POSTGRES_USER=axxiom_admin
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=require

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
ENTRA_SCOPE=openid profile email

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=axxiom-platform
JWT_AUDIENCE=axxiom-api

# API Keys
API_KEY_ENCRYPTION_KEY=
API_KEY_ROTATION_DAYS=90

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# Email Service (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@axxiom.ai
SENDGRID_FROM_NAME=Axxiom Platform

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Data Providers
ATTOM_DATA_API_KEY=
COSTAR_API_KEY=
REALTOR_API_KEY=
ZILLOW_API_KEY=

# Geospatial Services
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # Public key for frontend (restrict to domain)
MAPBOX_ACCESS_TOKEN=
HERE_API_KEY=

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# API Configuration
API_BASE_URL=http://localhost:3000
API_VERSION=v1
API_RATE_LIMIT_WINDOW=15m
API_RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.xlsx,.csv
UPLOAD_STORAGE_PATH=/tmp/uploads

# Report Generation
REPORT_TEMPLATE_PATH=./templates
REPORT_OUTPUT_PATH=/tmp/reports
REPORT_LOGO_URL=https://cdn.axxiom.ai/logo.png

# ============================================================================
# ML/AI CONFIGURATION
# ============================================================================

# Model Configuration
MODEL_VALUATION_VERSION=v1.2.0
MODEL_ASSESSMENT_VERSION=v1.0.0
MODEL_INFERENCE_TIMEOUT=30000
MODEL_BATCH_SIZE=100

# Feature Store
FEATURE_STORE_PATH=abfss://features@stadlsaxxiomdev.dfs.core.windows.net/
FEATURE_STORE_CACHE_TTL=3600

# LLM Configuration
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60000
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K_RESULTS=5
RAG_RERANK_ENABLED=true

# ============================================================================
# DATA INGESTION
# ============================================================================

# Scraping Configuration
SCRAPER_USER_AGENT=AxxiomBot/1.0 (+https://axxiom.ai/bot)
SCRAPER_RATE_LIMIT=10
SCRAPER_CONCURRENT_REQUESTS=5
SCRAPER_TIMEOUT=30000
SCRAPER_RESPECT_ROBOTS_TXT=true

# Data Quality
DATA_QUALITY_THRESHOLD=0.85
DATA_FRESHNESS_SLA_HOURS=24
DATA_VALIDATION_STRICT=true

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Logging
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_COLORIZE=false

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Tracing
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Features
FEATURE_APPEALS_MODULE=true
FEATURE_MASS_ASSESSMENT=true
FEATURE_MOBILE_APP=false
FEATURE_API_V2=false

# Experimental Features
EXPERIMENTAL_QUANTUM_VALUATION=false
EXPERIMENTAL_BLOCKCHAIN_RECORDS=false

# ============================================================================
# COMPLIANCE & GOVERNANCE
# ============================================================================

# Data Retention
DATA_RETENTION_DAYS=2555
LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=2555

# Privacy
ENABLE_GDPR_FEATURES=true
ENABLE_CCPA_FEATURES=true
COOKIE_CONSENT_REQUIRED=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Development Tools
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_DATA=false

# Testing
TEST_DATABASE_URL=
TEST_AZURE_STORAGE_ACCOUNT=
SEED_DATABASE=false
RESET_DATABASE_ON_START=false

# Performance
ENABLE_QUERY_LOGGING=false
ENABLE_SLOW_QUERY_WARNING=true
SLOW_QUERY_THRESHOLD_MS=1000

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_ACCOUNT=

# ============================================================================
# MULTI-TENANCY
# ============================================================================

DEFAULT_TENANT_ID=default
TENANT_ISOLATION_LEVEL=database
ENABLE_TENANT_PROVISIONING=true
MAX_TENANTS_PER_INSTANCE=100

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# PagerDuty
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_SERVICE_ID=

# Slack
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ALERTS=#alerts
SLACK_CHANNEL_DEPLOYS=#deploys

# ============================================================================
# DEPLOYMENT
# ============================================================================

DEPLOYMENT_ID=
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_TIMESTAMP=
DEPLOYMENT_COMMIT_SHA=
DEPLOYMENT_BRANCH=

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
