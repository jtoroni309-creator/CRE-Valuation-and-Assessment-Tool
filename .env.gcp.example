# ============================================================================
# Axxiom Platform - Google Cloud Platform Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env files to version control
# All secrets should be stored in Google Secret Manager for production
# ============================================================================

# ============================================================================
# Environment Configuration
# ============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================================================
# Google Cloud Platform Configuration
# ============================================================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Service Account (for local development only)
# In production, use Workload Identity or attached service accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# Google AI Platform - Vertex AI
# ============================================================================
GEMINI_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro-vision
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-004

# Vertex AI Endpoints (for custom ML models)
VALUATION_ML_ENDPOINT_ID=
PREDICTION_ML_ENDPOINT_ID=

# Vector Search (for RAG)
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_ENDPOINT_ID=

# ============================================================================
# Google Document AI
# ============================================================================
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_OCR_PROCESSOR=
DOCUMENT_AI_FORM_PROCESSOR=
DOCUMENT_AI_INVOICE_PROCESSOR=

# ============================================================================
# Cloud SQL - PostgreSQL
# ============================================================================
# Connection via Cloud SQL Proxy or Private IP
DATABASE_HOST=/cloudsql/project:region:instance
DATABASE_PORT=5432
DATABASE_NAME=axxiom
DATABASE_USER=axxiom_app

# Secret Manager reference for database password
DATABASE_PASSWORD_SECRET=projects/PROJECT_ID/secrets/axxiom-db-password/versions/latest

# Connection pool settings
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000

# ============================================================================
# Memorystore Redis
# ============================================================================
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
REDIS_PASSWORD_SECRET=projects/PROJECT_ID/secrets/axxiom-redis-auth/versions/latest
REDIS_TLS_ENABLED=true

# ============================================================================
# Cloud Storage Buckets
# ============================================================================
GCS_DATA_LAKE_BUCKET=axxiom-data-lake-PROJECT_ID-dev
GCS_REPORTS_BUCKET=axxiom-reports-PROJECT_ID-dev
GCS_ML_MODELS_BUCKET=axxiom-ml-models-PROJECT_ID-dev
GCS_UPLOADS_BUCKET=axxiom-uploads-PROJECT_ID-dev

# ============================================================================
# Google Cloud Identity Platform (Firebase Auth)
# ============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Identity Platform / Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_SECRET=projects/PROJECT_ID/secrets/google-oauth-secret/versions/latest

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET_SECRET=projects/PROJECT_ID/secrets/axxiom-jwt-secret/versions/latest
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Google Maps Platform
# ============================================================================
GOOGLE_MAPS_API_KEY_SECRET=projects/PROJECT_ID/secrets/google-maps-api-key/versions/latest
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key

# Maps features
MAPS_ENABLE_3D=true
MAPS_ENABLE_STREET_VIEW=true
MAPS_ENABLE_HEATMAP=true

# ============================================================================
# Third-Party Services
# ============================================================================

# Email (SendGrid)
SENDGRID_API_KEY_SECRET=projects/PROJECT_ID/secrets/sendgrid-api-key/versions/latest
SENDGRID_FROM_EMAIL=noreply@axxiom.app

# SMS (Twilio)
TWILIO_ACCOUNT_SID_SECRET=projects/PROJECT_ID/secrets/twilio-account-sid/versions/latest
TWILIO_AUTH_TOKEN_SECRET=projects/PROJECT_ID/secrets/twilio-auth-token/versions/latest
TWILIO_PHONE_NUMBER=+1234567890

# Payments (Stripe)
STRIPE_SECRET_KEY_SECRET=projects/PROJECT_ID/secrets/stripe-secret-key/versions/latest
STRIPE_WEBHOOK_SECRET_SECRET=projects/PROJECT_ID/secrets/stripe-webhook-secret/versions/latest
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ============================================================================
# Data Sources
# ============================================================================

# ATTOM Property Data
ATTOM_API_KEY_SECRET=projects/PROJECT_ID/secrets/attom-api-key/versions/latest
ATTOM_BASE_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0

# CoStar
COSTAR_API_KEY_SECRET=projects/PROJECT_ID/secrets/costar-api-key/versions/latest
COSTAR_CLIENT_ID_SECRET=projects/PROJECT_ID/secrets/costar-client-id/versions/latest

# Zillow
ZILLOW_API_KEY_SECRET=projects/PROJECT_ID/secrets/zillow-api-key/versions/latest

# ============================================================================
# Service URLs (Auto-configured in Cloud Run)
# ============================================================================
API_GATEWAY_URL=http://localhost:3000
VALUATION_SERVICE_URL=http://localhost:3001
COMPS_SERVICE_URL=http://localhost:3002
ASSESSMENT_SERVICE_URL=http://localhost:3003
APPEALS_SERVICE_URL=http://localhost:3004
REPORTING_SERVICE_URL=http://localhost:3005
AI_SERVICE_URL=http://localhost:3006
DATA_INGESTION_SERVICE_URL=http://localhost:3007
COMPUTER_VISION_SERVICE_URL=http://localhost:3008
GEOSPATIAL_SERVICE_URL=http://localhost:3009
PORTFOLIO_SERVICE_URL=http://localhost:3010

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_ENABLE_AI_CHAT=true
FEATURE_ENABLE_APPEALS=true
FEATURE_ENABLE_MASS_ASSESSMENT=true
FEATURE_ENABLE_PORTFOLIO=true
FEATURE_ENABLE_3D_MAPS=true
FEATURE_ENABLE_DOCUMENT_AI=true
FEATURE_ENABLE_VISION_AI=true
FEATURE_ENABLE_ML_PREDICTIONS=true

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AI_REQUESTS=20

# ============================================================================
# File Upload Limits
# ============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif,csv

# ============================================================================
# Observability - Cloud Monitoring
# ============================================================================
ENABLE_CLOUD_TRACE=true
ENABLE_CLOUD_PROFILER=true
ENABLE_ERROR_REPORTING=true
CLOUD_TRACE_SAMPLE_RATE=0.1

# ============================================================================
# Multi-Tenancy
# ============================================================================
TENANT_ISOLATION_LEVEL=database
MAX_TENANTS=1000
DEFAULT_TENANT_PLAN=professional

# ============================================================================
# Compliance & Security
# ============================================================================
DATA_RETENTION_DAYS=2555
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_ENCRYPTION=true
PII_MASKING_ENABLED=true
GDPR_ENABLED=true
CCPA_ENABLED=true

# ============================================================================
# Development & Testing
# ============================================================================
ENABLE_MOCK_DATA=false
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/axxiom_test
MOCK_AI_RESPONSES=false
