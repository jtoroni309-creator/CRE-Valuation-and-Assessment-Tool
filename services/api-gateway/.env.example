# API Gateway Configuration

NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:3100,http://localhost:3101

# Service URLs (internal)
VALUATION_SERVICE_URL=http://valuation-service:3001
COMPS_SERVICE_URL=http://comps-service:3002
ASSESSMENT_SERVICE_URL=http://assessment-service:3003
APPEALS_SERVICE_URL=http://appeals-service:3004
REPORTING_SERVICE_URL=http://reporting-service:3005

# Redis (for rate limiting)
AZURE_REDIS_CONNECTION_STRING=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_ISSUER=axxiom-platform
JWT_AUDIENCE=axxiom-api

# Logging
LOG_LEVEL=info
