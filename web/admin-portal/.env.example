# =============================================================================
# Axxiom Admin Portal - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing actual secrets

# =============================================================================
# API Configuration
# =============================================================================

# Base API URL (production: your API gateway URL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# AI Service endpoints
NEXT_PUBLIC_AI_SERVICE_URL=/api/v1/ai
NEXT_PUBLIC_VISION_SERVICE_URL=/api/v1/vision
NEXT_PUBLIC_DOCUMENT_SERVICE_URL=/api/v1/documents

# =============================================================================
# Timeouts (milliseconds)
# =============================================================================

NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_AI_TIMEOUT=60000
NEXT_PUBLIC_UPLOAD_TIMEOUT=120000

# =============================================================================
# Retry Configuration
# =============================================================================

NEXT_PUBLIC_API_MAX_RETRIES=3
NEXT_PUBLIC_API_RETRY_DELAY=1000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable mock data for development (set to 'false' for production)
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# Enable debug mode (set to 'false' for production)
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# Authentication
# =============================================================================

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Analytics (optional)
# =============================================================================

NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# =============================================================================
# Maps Configuration
# =============================================================================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
