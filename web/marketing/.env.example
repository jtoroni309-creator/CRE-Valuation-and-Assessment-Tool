# =============================================================================
# Axxiom Marketing Site - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing actual secrets

# =============================================================================
# Site Configuration
# =============================================================================

# Production URL for sitemap and canonical URLs
SITE_URL=https://axxiom.io

# Next.js public URL (auto-configured in most deployments)
NEXT_PUBLIC_SITE_URL=https://axxiom.io

# =============================================================================
# API Configuration
# =============================================================================

# API base URL for form submissions
NEXT_PUBLIC_API_URL=https://api.axxiom.io

# =============================================================================
# Analytics
# =============================================================================

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=

# LinkedIn Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# =============================================================================
# Third-Party Integrations
# =============================================================================

# HubSpot (for forms and CRM)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=

# Intercom (for chat widget)
NEXT_PUBLIC_INTERCOM_APP_ID=

# Calendly (for demo scheduling)
NEXT_PUBLIC_CALENDLY_URL=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable chat widget
NEXT_PUBLIC_ENABLE_CHAT=true

# Enable/disable cookie consent banner
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true

# =============================================================================
# SEO & Verification
# =============================================================================

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Bing Webmaster Tools verification
NEXT_PUBLIC_BING_VERIFICATION=

# =============================================================================
# Build Configuration
# =============================================================================

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1
